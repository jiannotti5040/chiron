#!/usr/bin/env python3
"""chiron — the single entry point for the vault.

Three concepts, nothing else:

    Source    Chiron/ (+ Primus/)   you edit here, always
    Build     chiron build          folds source -> monolith, refreshes the manifest
    Artifact  Chiron Monolith/      run it, ship it, delete it, rebuild it — never edit it

Daily verbs:

    chiron dev  [args...]      run the spine        (python3 Chiron/chiron.py ...)
    chiron run  [args...]      run the artifact     (python3 'Chiron Monolith/chiron_monolith.py' ...)
    chiron build [--full]      rebuild monolith + manifest (--full: manifest re-runs selftests)
    chiron test [--full]       the gate battery, same gates as CI
                               (--full adds primus benchmark, certify fuzz, MCP gates,
                                cached-OEIS external validation, and the full monolith sweep)
    chiron serve [--core]      every service via vault.py (console :8765, launcher :8768,
                               assistant :8769, grow :8767, President :8766); one Ctrl-C
    chiron grow [--live]       knowledge grower     (dry-run by default; --live mutates Congress)
    chiron verify <input>      ingest one string/file and certify it exactly

  Reading verbs — each takes a string, a file path, or `-` for stdin:

    chiron analyze <input>     every applicable stage over one text (the wide read)
    chiron verify <input> [--facts=<json|file>]
                               the exact certificate. Without --facts, a claim
                               whose truth lives outside the sentence REFUSES;
                               with them it is checked against exactly one
                               named fact, or refuses by name
    chiron collapse <input>    the canonical Primus invariant, or an honest refusal
    chiron attest <input> --input=<file> [--input=...]
                               which supplied source produced each span;
                               with no --input the answer is REFUSED, by design
    chiron solve <input> [--intent="..."]
                               goal-directed campaign: recover, prove, record;
                               HALTs on an unproven step, ESCALATEs an
                               irreversible one — both are results (prototype)
    chiron lineage <input>     the evidence graph: what each claim stands on,
                               what contradicts it, and what stands on nothing
    chiron explore <input>     what else would have fit; rivals searched
    chiron compare <a> <b>     two surfaces on stated axes; no composite score
    chiron falsify <input> [--facts=...]
                               what would overturn this; for a refusal, the
                               specific evidence nobody supplied
    chiron experiment <input> [--facts=...]
                               the cheapest next observation, or nothing
    chiron engines [query]     the reviewed static allowlist an agent may invoke
    chiron mcp                 serve the vault over stdio to Claude Code / Codex

    chiron benchmark [--suite] proving run (--suite: six-task cross-domain suite)
    chiron parity              prove spine and fold are ONE organism: identical gate
                               outcomes through both incarnations, or it fails
    chiron plan <surface>      run a composed campaign (observe→analyze→verify→
                               remember→escalate); the gate arbitrates every step
    chiron demo                self-contained demonstration
    chiron doctor              environment + vault sanity report
    chiron clean               sweep caches (__pycache__) out of the tree

Install once:  alias chiron='python3 "<vault>/bin/chiron"'   (or add bin/ to PATH)

Every command is a thin, transparent delegation — the exact child command is shown
before it runs. The dozens of Python files are implementation details; this
interface is the product.
"""
import os
import re
import shutil
import subprocess
import sys

VAULT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CHIRON = os.path.join(VAULT, "Chiron")
PRIMUS = os.path.join(VAULT, "Primus")
MONO_DIR = os.path.join(VAULT, "Chiron Monolith")
MONOLITH = os.path.join(MONO_DIR, "chiron_monolith.py")
PY = sys.executable or "python3"


def _run(argv, cwd=None, **kw):
    """Delegate to a child process, showing the exact command (no hidden magic).
    Every delegation is memorialized in the run ledger — the witness never gates."""
    import time
    pretty = " ".join(a if " " not in a else f"'{a}'" for a in argv)
    where = f"  (in {os.path.relpath(cwd, VAULT)})" if cwd and cwd != VAULT else ""
    print(f"[chiron] $ {pretty}{where}", flush=True)
    t0 = time.time()
    rc = subprocess.call(argv, cwd=cwd or VAULT, **kw)
    try:
        sys.path.insert(0, CHIRON)
        import run_ledger
        engine = os.path.basename(str(argv[1])) if len(argv) > 1 else "?"
        # argv may contain a complete prompt or imported document.  The
        # operational ledger needs a correlation witness, not that content.
        run_ledger.record(engine, [str(a) for a in argv[2:6]], ok=(rc == 0),
                          verdict=f"exit {rc}", seconds=time.time() - t0,
                          source="cli", redact=True)
    except Exception:
        pass
    return rc


def _script(name):
    return os.path.join(CHIRON, name)


def _primus_cli(args, **kw):
    """Run the canonical packaged Primus CLI from a source checkout too.

    `bin/chiron` is deliberately usable before `pip install ./Primus`; add the
    source package only to this child process rather than relying on a global
    installation or changing the caller's environment.
    """
    env = os.environ.copy()
    source = os.path.join(PRIMUS, "src")
    inherited = env.get("PYTHONPATH")
    env["PYTHONPATH"] = source if not inherited else source + os.pathsep + inherited
    return _run([PY, "-m", "primus.cli"] + args, env=env, **kw)


def cmd_dev(args):
    return _run([PY, _script("chiron.py")] + (args or ["--help"]))


def cmd_run(args):
    if not os.path.isfile(MONOLITH):
        print("[chiron] no artifact yet — run `chiron build` first"); return 2
    return _run([PY, MONOLITH] + (args or ["--help"]))


def cmd_build(args):
    full = "--full" in args
    rc = _run([PY, os.path.join(MONO_DIR, "build_monolith.py")], cwd=MONO_DIR)
    if rc:
        return rc
    manifest = [PY, _script("build_manifest.py")]
    if full:
        manifest.append("--run")
    rc = _run(manifest)
    if rc:
        return rc
    print("[chiron] build complete: artifact + manifest are fresh")
    return 0


def cmd_test(args):
    """The gate battery — the same gates CI runs. A failing gate is information,
    not an obstacle: investigate, fix the root cause, never widen a tolerance."""
    full = "--full" in args
    gates = [
        ("spine selftest (embedded suite)", [PY, _script("chiron.py"), "selftest"], None),
        ("primus stress tests (48 gates)", [PY, "test_invariant_engine.py"], PRIMUS),
        ("twin cross-lock (corpus <-> exact <-> engine)", [PY, "test_twins_exact.py"], PRIMUS),
        ("unit: chiron", [PY, _script(os.path.join("tests", "test_chiron.py"))], None),
        ("CLI contract (canonical exact verify)",
         [PY, _script(os.path.join("tests", "test_bin_cli.py"))], None),
        ("unit: grow", [PY, _script(os.path.join("tests", "test_grow.py"))], None),
        ("Chiron MCP transport (real stdio JSON-RPC)",
         [PY, _script(os.path.join("tests", "test_mcp_server.py"))], None),
        ("local browser CORS (real loopback HTTP)",
         [PY, _script(os.path.join("tests", "test_local_cors.py"))], None),
        ("assistant and console execution policy",
         [PY, _script(os.path.join("tests", "test_execution_policy.py"))], None),
        ("bounded local source provenance",
         [PY, _script(os.path.join("tests", "test_source_provenance.py"))], None),
        ("external ontology / Foundry boundary",
         [PY, _script(os.path.join("tests", "test_foundry_boundary.py"))], None),
        ("license claims (current surfaces match Apache-2.0)",
         [PY, os.path.join(VAULT, "ci", "check_license_claims.py")], None),
        ("falsifiers + experiment design (what would overturn this)",
         [PY, _script("falsify.py"), "selftest"], None),
        ("grounded claims (exact against supplied facts, or refuse)",
         [PY, "-c",
          "import sys;sys.path.insert(0,'Primus/src');"
          "from primus.grounded import _selftest;sys.exit(_selftest())"], None),
        ("PDF text layer (extracts, or refuses by name)",
         [PY, _script("pdf_text.py"), "selftest"], None),
        ("web boundary + prompt injection (closed by default; text stays data)",
         [PY, _script("web_boundary.py"), "selftest"], None),
        ("explore/compare (rivals searched; no composite score)",
         [PY, _script("compare_explore.py"), "selftest"], None),
        ("evidence graph (lineage, contradictions, and what stands on nothing)",
         [PY, _script("evidence_graph.py"), "selftest"], None),
        ("SBOM (every third-party import is declared or guarded)",
         [PY, os.path.join(VAULT, "ci", "sbom.py"), "--check"], None),
        ("grow dry-run", [PY, _script("chiron_grow.py"), "--params",
                          _script(os.path.join("grow-public", "parameters.json")),
                          "--dry-run", "--once"], None),
        ("drift detector (seed vs monolith)", [PY, "drift_check.py"], PRIMUS),
        ("adversarial stress probes (parity teeth, certificate honesty, ledger, security, 0-false, certify)",
         [PY, _script("stress_test.py"), "selftest"], None),
        ("pipeline composer (chain/team/swarm; AND-of-required, never a false verify)",
         [PY, _script("pipeline.py"), "selftest"], None),
        ("SOP smoke (every documented command runs as written)",
         [PY, os.path.join(VAULT, "ci", "sop_smoke.py")], None),
    ]
    if full:
        gates += [
            ("primus internal benchmark (zero false confidence)", [PY, "benchmark.py"], PRIMUS),
            ("adversarial fuzz gates (certify layer)", [PY, "test_certify_fuzz.py"], PRIMUS),
            ("MCP server handshake (protocol gates)", [PY, "test_mcp_server.py"], PRIMUS),
            ("external validation (cached live-OEIS corpus)", [PY, "oeis_live.py"], PRIMUS),
        ]
    if os.path.isfile(MONOLITH):
        gates.append(("monolith " + ("full sweep" if full else "smoke"),
                      [PY, MONOLITH, "--selftest" if full else "--smoke"], MONO_DIR))
    failed = []
    for name, argv, cwd in gates:
        print(f"\n[chiron] ── gate: {name} " + "─" * max(1, 46 - len(name)), flush=True)
        if _run(argv, cwd=cwd):
            failed.append(name)
    print("\n[chiron] " + ("GATE BATTERY GREEN — all gates passed" if not failed
          else f"GATES FAILED: {', '.join(failed)}"))
    return 1 if failed else 0


def cmd_serve(args):
    """The whole cockpit with one command — delegates to Chiron/vault.py, the
    service supervisor. `--core` starts just the engine + console."""
    return _run([PY, _script("vault.py")] + [a for a in args if a == "--core"])


def cmd_grow(args):
    live = "--live" in args
    passthrough = [a for a in args if a not in ("--live",)]
    argv = [PY, _script("chiron_grow.py"), "--params",
            _script(os.path.join("grow-public", "parameters.json"))]
    if not live:
        argv += ["--dry-run", "--once"]
        print("[chiron] dry-run (real Congress untouched); pass --live to mutate")
    return _run(argv + passthrough)


def _facts_from(args):
    """Load --facts=<json-or-file> for the grounded claim kind."""
    import json
    specs = [a.split("=", 1)[1] for a in args if a.startswith("--facts=")]
    if not specs:
        return None, [a for a in args if not a.startswith("--facts=")]
    spec = specs[0]
    if os.path.isfile(spec):
        with open(spec, "r", encoding="utf-8") as fh:
            return json.load(fh), [a for a in args if not a.startswith("--facts=")]
    return json.loads(spec), [a for a in args if not a.startswith("--facts=")]


def cmd_verify(args):
    """Certify exactly one supplied text value, file, or stdin stream.

    This must remain a thin adapter around `primus certify`: the organism's
    ingestion workflow is valuable, but it is not an exact claim certificate
    and must never be substituted for one.
    """
    facts, args = _facts_from(args)
    if facts is not None:
        # The packaged primus CLI has no --facts; the grounded kind is reached
        # through the shared dispatch so every interface gets the same code.
        text, gflags = _text_argv([a for a in args if a not in ("--gate",)],
                                  "verify", ("--json",))
        if text is None:
            return 2
        return _tool_call("certify", {"text": text, "facts": facts},
                          "--json" in gflags)
    flags = [arg for arg in args if arg in ("--json", "--gate")]
    targets = [arg for arg in args if arg not in ("--json", "--gate")]
    bad = [arg for arg in targets if arg.startswith("-") and arg != "-"]
    if len(targets) != 1 or bad:
        print("usage: chiron verify <string-or-file|-> [--json] [--gate]")
        return 2
    target = targets[0]
    if os.path.isdir(target):
        print("[chiron] verify accepts one regular file, not a directory")
        return 2
    command = ["certify", "-"] + flags
    if target == "-":
        return _primus_cli(command)
    if os.path.isfile(target):
        # Stream exactly the selected file rather than treating its parent
        # directory as an ingestion target.  The canonical certificate hashes
        # and records any text truncation itself.
        try:
            with open(target, "rb") as source:
                return _primus_cli(command, stdin=source)
        except OSError as exc:
            print(f"[chiron] could not read selected file: {exc}")
            return 2
    return _primus_cli(["certify", target] + flags)


def _text_argv(args, verb, extra=()):
    """Resolve one text-or-file-or-stdin target the way `verify` already does.

    Every reading verb takes its input the same way, so a shell script does not
    have to remember which one wanted a flag and which one wanted a path.
    """
    flags = [a for a in args if a in extra]
    targets = [a for a in args if a not in extra]
    bad = [a for a in targets if a.startswith("-") and a != "-"]
    # A bare sequence is the natural way to type one: `chiron collapse 1 1 2 3`
    # should mean what `chiron plan 1 1 2 3` already means. Only numbers are
    # joined — several words would be an ambiguous request, not a surface, and
    # are still rejected.
    if len(targets) > 1 and not bad and all(
            re.fullmatch(r"-?\d+(\.\d+)?", t) for t in targets):
        return " ".join(targets), flags
    if len(targets) != 1 or bad:
        print(f"usage: chiron {verb} <string-or-file|-> "
              + " ".join(f"[{f}]" for f in extra))
        if len(targets) > 1:
            print("       (a multi-word surface needs quoting; a bare list of "
                  "numbers does not)")
        return None, None
    target = targets[0]
    if os.path.isdir(target):
        print(f"[chiron] {verb} accepts one regular file, not a directory")
        return None, None
    if target == "-":
        return sys.stdin.read(), flags
    if os.path.isfile(target):
        try:
            with open(target, "r", encoding="utf-8", errors="replace") as fh:
                return fh.read(), flags
        except OSError as exc:
            print(f"[chiron] could not read selected file: {exc}")
            return None, None
    return target, flags


def _tool_call(name, arguments, as_json):
    """Invoke a vault tool through the *same* dispatch the MCP server uses.

    `Chiron/mcp_server.py:_IMPL` is the one place a tool name becomes a call.
    Routing the CLI through it is the whole point: a terminal, an agent, and
    the app then cannot disagree about what a tool does, because there is only
    one implementation and one contract to disagree about.
    """
    import json
    sys.path.insert(0, CHIRON)
    try:
        import mcp_server
    except Exception as exc:
        print(f"[chiron] could not load the vault tool table: {exc}")
        return 1
    impl = mcp_server._IMPL.get(name)
    if impl is None:
        print(f"[chiron] no such tool: {name}")
        return 2
    try:
        payload = impl(arguments)
    except mcp_server.ToolError as exc:
        print(f"[chiron] {name}: {exc}")
        return 2
    # _wrap puts the record in MCP content envelopes; unwrap to the record.
    record = payload
    if isinstance(payload, dict) and "content" in payload:
        try:
            record = json.loads(payload["content"][0]["text"])
        except Exception:
            record = payload
    print(json.dumps(record, indent=2 if as_json else None)
          if as_json else _render(name, record))
    # A refusal is a result, not a failure: it exits 0. Only a malformed
    # request or a broken engine is a non-zero exit.
    return 0


def _render(name, record):
    """A short human line per tool; --json is the machine contract."""
    import json
    if not isinstance(record, dict):
        return str(record)
    if name == "attest":
        spans = record.get("spans") or []
        counts = {}
        for span in spans:
            counts[span.get("verdict")] = counts.get(span.get("verdict"), 0) + 1
        head = " · ".join(f"{v} {k}" for k, v in sorted(counts.items()))
        lines = [f"[chiron] attest · {len(spans)} span(s) · "
                 f"{head or 'nothing to attribute'}"]
        for span in spans:
            # Two independent facts, never collapsed into one. `origin` is
            # where the words came from; `verdict` is whether the claim could
            # be checked. A span can be perfectly attributed and still REFUSED
            # because no exact checker covers its domain — reporting that as
            # "unattributed" would be false.
            origin = span.get("origin")
            novel = [t["text"] for t in (span.get("tokens") or [])
                     if t.get("novel")]
            where = (f"traces to {origin}"
                     + (f" (cosine {span['origin_cosine']:.2f})"
                        if isinstance(span.get("origin_cosine"), float) else "")
                     if origin else "traces to nothing supplied")
            lines.append(f"  [{span.get('verdict')}] "
                         f"{str(span.get('text', ''))[:66]}")
            lines.append(f"      {where}")
            if span.get("reason"):
                lines.append(f"      verdict because: {span['reason']}")
            if novel:
                lines.append(f"      novel words ({len(novel)}): "
                             + ", ".join(novel[:12]))
        return "\n".join(lines)
    if name in ("explore", "compare"):
        sys.path.insert(0, CHIRON)
        import compare_explore
        return (compare_explore.render_explore(record) if name == "explore"
                else compare_explore.render_compare(record))
    if name == "certify":
        c = record.get("counts", {})
        lines = [f"[chiron] certify · coverage {record.get('coverage', 0):.1%} · "
                 f"{c.get('verified',0)} verified · {c.get('refuted',0)} refuted · "
                 f"{c.get('refused',0)} refused"]
        g = record.get("grounding")
        if g:
            lines.append(f"  grounded against {g['facts_supplied']} supplied fact(s)")
            for bad in g.get("facts_rejected") or []:
                lines.append(f"    rejected fact: {bad}")
        for cl in record.get("claims") or []:
            lines.append(f"  [{cl['status']}] {str(cl.get('text',''))[:56]}")
            if cl.get("reason"):
                lines.append(f"      {str(cl['reason'])[:70]}")
        return "\n".join(lines)
    if name == "lineage":
        lines = [f"[chiron] lineage · {record.get('schema')} · "
                 f"{len(record.get('records') or [])} records · "
                 f"{record.get('edge_count')} edges"]
        counts = record.get("counts") or {}
        lines.append("  " + " · ".join(f"{v} {k}" for k, v in sorted(counts.items())))
        for c in (record.get("contradictions") or []):
            lines.append(f"  CONTRADICTED  {str(c.get('claim'))[:60]}")
        for u in (record.get("unsupported") or []):
            lines.append(f"  stands on nothing [{u.get('verdict') or '—'}]  "
                         f"{str(u.get('claim'))[:56]}")
        return "\n".join(lines)
    if name == "solve":
        lines = [f"[chiron] solve · {record.get('status')} · "
                 f"{record.get('steps_used')} step(s) · "
                 f"{record.get('epistemic_status')}"]
        for st in (record.get("steps") or []):
            mark = "ok " if st.get("ok") else "NO "
            irr = " [irreversible — not performed]" if st.get("irreversible") else ""
            lines.append(f"  {mark}{st.get('step'):<16}{str(st.get('verdict'))[:72]}{irr}")
        for law in (record.get("laws") or []):
            lines.append(f"  law: {law.get('model_class')} "
                         f"verified={law.get('verified')} "
                         f"predicts {law.get('predicts_next')}")
        return "\n".join(lines)
    if name in ("collapse", "trace"):
        return json.dumps({k: record.get(k) for k in
                           ("schema", "verified", "engine_verdict",
                            "model_class", "explanation") if k in record},
                          indent=2)
    return json.dumps(record, indent=2)


def cmd_analyze(args):
    """Every applicable stage of the vault over one text — the full reading.

    This is the wide, interpretive pass. It is not a certificate: `analyze`
    tells you what the stack observed, `verify` tells you what it could prove.
    """
    text, flags = _text_argv(args, "analyze", ("--json",))
    if text is None:
        return 2
    return _run([PY, _script("full_stack.py")]
                + (["--json"] if "--json" in flags else []) + [text])


def cmd_attest(args):
    """Word-level provenance: which supplied input produced each span.

    Requires the candidate inputs. With none, every span is REFUSED — that is
    the honest answer, not a failure, because attribution here is always
    relative to sources the caller supplies. This verb will not pretend
    otherwise, and it reports no probability that text is machine-written.
    """
    inputs = [a.split("=", 1)[1] for a in args if a.startswith("--input=")]
    rest = [a for a in args if not a.startswith("--input=")]
    text, flags = _text_argv(rest, "attest", ("--json",))
    if text is None:
        print("       (repeat --input=<file> for each candidate source)")
        return 2
    if not inputs:
        print("[chiron] attest with no --input: every span will be REFUSED. "
              "Pass --input=<file> for each document the text was written "
              "from. Continuing, so the refusal is visible rather than "
              "assumed.")
    return _tool_call("attest", {"output": text, "input_paths": inputs},
                      "--json" in flags)


def cmd_collapse(args):
    """The canonical Primus invariant result for a sequence or string."""
    text, flags = _text_argv(args, "collapse", ("--json",))
    if text is None:
        return 2
    return _tool_call("collapse", {"surface": text}, "--json" in flags)


def cmd_trace(args):
    """The diagnostic explanation — why a surface did or did not collapse.

    Deliberately non-stamping: `trace` explains, `verify` certifies. A trace
    never turns into a certificate.
    """
    text, flags = _text_argv(args, "trace", ("--json",))
    if text is None:
        return 2
    return _tool_call("trace", {"surface": text}, "--json" in flags)


def cmd_solve(args):
    """Run a goal-directed campaign: recover, prove, record, escalate.

    Composes `planner.run_campaign` — it does not re-solve anything. A step
    that cannot be verified HALTS rather than advancing on an unproven
    premise, and a step that leaves the reversible sandbox is ESCALATED rather
    than performed. Both are successful outcomes. Epistemic status: prototype.
    """
    intents = [a.split("=", 1)[1] for a in args if a.startswith("--intent=")]
    rest = [a for a in args if not a.startswith("--intent=")]
    text, flags = _text_argv(rest, "solve", ("--json",))
    if text is None:
        print("       (optionally --intent=\"what the campaign is for\")")
        return 2
    payload = {"surface": text}
    if intents:
        payload["intent"] = intents[0]
    return _tool_call("solve", payload, "--json" in flags)


def cmd_lineage(args):
    """The evidence graph behind a text: what each claim stands on.

    Same run as `verify`, different question. `verify` answers what came out;
    `lineage` answers what it is standing on and what contradicts it. A claim
    nothing supports — including every REFUSED one — is listed rather than
    buried, because that is the part of a result that is not holding anything
    up.
    """
    text, flags = _text_argv(args, "lineage", ("--json",))
    if text is None:
        return 2
    return _tool_call("lineage", {"text": text}, "--json" in flags)


def cmd_explore(args):
    """What else would have fit — the rivals searched and whether one survived."""
    text, flags = _text_argv(args, "explore", ("--json",))
    if text is None:
        return 2
    return _tool_call("explore", {"surface": text}, "--json" in flags)


def cmd_compare(args):
    """Two surfaces on stated axes. No composite score, by design."""
    flags = [a for a in args if a == "--json"]
    targets = [a for a in args if a != "--json"]
    if len(targets) != 2:
        print("usage: chiron compare <surface-a> <surface-b> [--json]")
        print("       (quote each surface: chiron compare \"1 2 4 8\" \"1 1 2 3 5\")")
        return 2
    return _tool_call("compare", {"left": targets[0], "right": targets[1]},
                      bool(flags))


def cmd_falsify(args):
    """What would overturn this, and what evidence is missing to check it."""
    facts, args = _facts_from(args)
    text, flags = _text_argv(args, "falsify", ("--json",))
    if text is None:
        return 2
    payload = {"text": text} if facts is not None else {"surface": text}
    if facts is not None:
        payload["facts"] = facts
    return _tool_call("falsifiers", payload, "--json" in flags)


def cmd_experiment(args):
    """The cheapest next observation, or an honest nothing."""
    facts, args = _facts_from(args)
    text, flags = _text_argv(args, "experiment", ("--json",))
    if text is None:
        return 2
    payload = {"text": text, "facts": facts} if facts is not None else {"surface": text}
    return _tool_call("propose_experiment", payload, "--json" in flags)


def cmd_engines(args):
    """The reviewed static allowlist — every operation an agent may invoke.

    Reads the same `TOOLS` table the MCP server serves, so the CLI and the
    agent surface can never disagree about what exists. Arbitrary module
    dispatch is intentionally absent here as well.
    """
    import json
    sys.path.insert(0, CHIRON)
    try:
        import mcp_server
    except Exception as exc:
        print(f"[chiron] could not load the tool table: {exc}")
        return 1
    query = next((a for a in args if not a.startswith("-")), None)
    catalog = mcp_server._catalog(query)
    if "--json" in args:
        print(json.dumps(catalog, indent=2))
        return 0
    tools = catalog["tools"]
    print(f"[chiron] {len(tools)} tool(s) · schema {catalog['schema']} · "
          f"reviewed static allowlist")
    for tool in tools:
        meta = tool["metadata"]
        print(f"\n  {tool['name']}  [{meta['authority']}]")
        print(f"    {tool['description']}")
        print(f"    contract {meta['contract']} · side effects "
              f"{meta['side_effects']}")
    return 0


def cmd_mcp(args):
    """Serve the vault to Claude Code, Codex, and any MCP client over stdio.

    This is the one verb that must not go through `_run`. Every other
    delegation prints `[chiron] $ ...` to stdout first, which is a courtesy
    for a human and a corruption for a client: stdio MCP requires that stdout
    carry framed JSON-RPC and nothing else. The banner goes to stderr and the
    process is replaced, so the server owns the stream outright.
    """
    argv = [PY, _script("mcp_server.py")] + list(args)
    print("[chiron] $ " + " ".join(argv), file=sys.stderr, flush=True)
    os.execv(PY, argv)


def cmd_benchmark(args):
    script = "bench_suite.py" if "--suite" in args else "benchmark.py"
    return _run([PY, _script(script)])


def cmd_demo(args):
    return _run([PY, _script("chiron.py"), "demo"])


def cmd_plan(args):
    if not args:
        print("usage: chiron plan <surface>   e.g. chiron plan 1 1 2 3 5 8"); return 2
    return _run([PY, _script("planner.py"), "run"] + args)


def cmd_parity(args):
    """Spine <-> fold: run the spine's own gate suite through BOTH incarnations and
    require identical outcomes, gate by gate. The fold is only trustworthy while
    this cannot find a difference."""
    import re
    if not os.path.isfile(MONOLITH):
        print("[chiron] no artifact — run `chiron build` first"); return 2
    outcomes = {}
    for name, argv, cwd in (("spine", [PY, _script("chiron.py"), "selftest"], None),
                            ("fold ", [PY, MONOLITH, "chiron", "selftest"], MONO_DIR)):
        print(f"[chiron] ── parity: {name.strip()} incarnation", flush=True)
        p = subprocess.run(argv, cwd=cwd or VAULT, capture_output=True, text=True)
        gates = sorted((m.group(2).strip(), m.group(1))
                       for m in re.finditer(r"\[(PASS|FAIL)\]\s+(.+)", p.stdout + p.stderr))
        outcomes[name.strip()] = (p.returncode, gates)
        print(f"          exit {p.returncode} · {len(gates)} gates observed")
    (rc_s, g_s), (rc_f, g_f) = outcomes["spine"], outcomes["fold"]
    identical, green = g_s == g_f, rc_s == 0 and rc_f == 0
    if identical and green and g_s:
        print(f"\n[chiron] PARITY GREEN — {len(g_s)} gates, identical outcomes through both incarnations")
        return 0
    print("\n[chiron] PARITY BROKEN — do not trust either incarnation until this is understood:")
    ds, df = dict(g_s), dict(g_f)
    for k in sorted(set(ds) | set(df)):
        if ds.get(k) != df.get(k):
            print(f"  spine={ds.get(k) or 'absent'} · fold={df.get(k) or 'absent'} · {k[:80]}")
    if rc_s or rc_f:
        print(f"  exit codes: spine={rc_s} fold={rc_f}")
    return 1


def cmd_doctor(args):
    ok = True
    def check(label, cond, hint=""):
        nonlocal ok
        mark = "OK " if cond else "FAIL"
        if not cond:
            ok = False
        print(f"  [{mark}] {label}" + (f" — {hint}" if hint and not cond else ""))
    print("[chiron] vault doctor\n")
    v = sys.version_info
    check(f"python {v.major}.{v.minor}.{v.micro} (need 3.9+)", (v.major, v.minor) >= (3, 9))
    try:
        import numpy  # noqa: F401
        check("numpy available (CI parity)", True)
    except Exception:
        check("numpy available (CI parity)", False, "pip install numpy")
    check("source spine    Chiron/chiron.py", os.path.isfile(_script("chiron.py")))
    check("seed package    Primus/src/primus/engine.py",
          os.path.isfile(os.path.join(PRIMUS, "src", "primus", "engine.py")),
          "the packaged seed is missing — is this checkout complete?")
    check("build script    Chiron Monolith/build_monolith.py",
          os.path.isfile(os.path.join(MONO_DIR, "build_monolith.py")))
    check("artifact        Chiron Monolith/chiron_monolith.py", os.path.isfile(MONOLITH),
          "run `chiron build`")
    check("manifest        Chiron/manifest.json", os.path.isfile(_script("manifest.json")),
          "run `chiron build`")
    check("lexicon         Chiron/lexicon.json", os.path.isfile(_script("lexicon.json")))
    check("Congress        Chiron/chiron_memory.json",
          os.path.isfile(_script("chiron_memory.json")))
    arts = _script("artifacts")
    n = sum(1 for d in (os.listdir(arts) if os.path.isdir(arts) else [])
            if os.path.isfile(os.path.join(arts, d, "latest.json")))
    check(f"artifact ledger: {n} engines with latest.json certificates", n > 0)
    if os.path.isfile(MONOLITH) and os.path.isfile(_script("chiron.py")):
        # mtime heuristic only — informational, never fails the doctor (CI checkouts
        # randomize mtimes; the authoritative drift gates are Primus/drift_check.py
        # and CI's rebuild-and-diff step).
        fresh = os.path.getmtime(MONOLITH) >= max(
            os.path.getmtime(os.path.join(CHIRON, f))
            for f in os.listdir(CHIRON) if f.endswith(".py"))
        print(f"  [{'OK ' if fresh else 'NOTE'}] artifact vs source mtime"
              + ("" if fresh else " — source may have changed since the last fold; run `chiron build`"))
    print("\n[chiron] " + ("healthy" if ok else "issues found — see FAIL lines above"))
    return 0 if ok else 1


def cmd_clean(args):
    swept = 0
    for root, dirs, _files in os.walk(VAULT):
        if ".git" in root or ".trash" in root:
            continue
        for d in list(dirs):
            if d == "__pycache__":
                path = os.path.join(root, d)
                try:
                    shutil.rmtree(path)
                except OSError:
                    dest = os.path.join(VAULT, ".trash",
                                        path.replace(VAULT, "").strip(os.sep).replace(os.sep, "_"))
                    os.makedirs(os.path.join(VAULT, ".trash"), exist_ok=True)
                    shutil.move(path, dest)
                dirs.remove(d)
                swept += 1
    print(f"[chiron] swept {swept} cache dir(s)")
    return 0


COMMANDS = {
    "dev": cmd_dev, "run": cmd_run, "build": cmd_build, "test": cmd_test,
    "serve": cmd_serve, "grow": cmd_grow, "verify": cmd_verify,
    "benchmark": cmd_benchmark, "demo": cmd_demo, "parity": cmd_parity,
    "plan": cmd_plan, "doctor": cmd_doctor, "clean": cmd_clean,
    "analyze": cmd_analyze, "attest": cmd_attest, "collapse": cmd_collapse,
    "trace": cmd_trace, "solve": cmd_solve, "lineage": cmd_lineage,
    "explore": cmd_explore, "compare": cmd_compare,
    "falsify": cmd_falsify, "experiment": cmd_experiment,
    "engines": cmd_engines,
    "mcp": cmd_mcp,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd not in COMMANDS:
        print(f"[chiron] unknown command: {cmd}\n")
        print(__doc__)
        return 2
    return COMMANDS[cmd](args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
