# ============================================================
# Jacob's Portfolio Vault — one section per concern, no dupes.
# ============================================================

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- compiled native extensions ---
*.so
*.dylib
*.dll
*.rlib
target/

# --- build / packaging ---
build/
dist/
*.egg-info/
.eggs/
*.spec
App/.build/
App/build/

# --- environments ---
.venv/
venv/
env/

# --- secrets: NEVER commit; providers read keys from the environment only ---
.env
.env.*
*.env
**/.env
**/*.env
*_api_key*
*_secret*
.chiron_llm*
llm_keys*
secrets.json
chiron.key
*.sealed
**/transcribe_hf_token
transcribe_hf_token

# --- editor / OS noise ---
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp

# --- vault runtime state (regenerated by running the scripts) ---
president_ledger.jsonl
*_pres*.jsonl
veritas_laws.jsonl
chiron_checkpoint_*.json
chiron_control.json
chiron_grow_state.json
*_grow_state.json
grow_control_state.json
**/grow_control_state.json
grow.log
nohup.out
*.dryrun
Chiron/artifacts/run_ledger.jsonl
Chiron/artifacts/heart_state.json
Chiron/artifacts/heart_congress.json

# --- artifact ledger: keep latest.json, ignore timestamped run memorials ---
Chiron/artifacts/*/[0-9]*.json

# --- monolith folder: runtime Congress copy (regenerated by build_monolith.py) ---
Chiron Monolith/chiron_memory.json

# --- grown Congress state: runtime, regenerated, and NOT ours to relicense ---
# A grown Congress stores each ingested text's distinct valid readings in
# `spectrum`. For unambiguous input that reading IS the source text, so a
# Wikipedia-grown Congress carries verbatim article prose — CC BY-SA 4.0,
# which is one-way incompatible with this repo's Apache-2.0 / CC BY 4.0.
# The vault is content-addressed (key = org_sha(payload), folded into the
# sealed manifest root), so the text cannot be stripped in place without
# breaking the integrity property that makes the store worth having.
# It is regenerable: `chiron.py selftest` is 12/12 green without it.
Chiron/chiron_memory.json

# --- local staging for files awaiting manual deletion (some sandboxes cannot unlink) ---
.trash/

# --- deliberately untracked local material ---
Creative Works/
Semic Dev/
Chiron-Refined/
modules/
**/modules/
proposals/
Resume*.md
Resume*.pdf
Resume*.docx
*Primus Calamus*.pdf

# --- transcribe tool: local env + temp audio ---
**/.transcribe_env/
*_temp_audio.wav

# PySR run artifacts (bench_pysr.py) — anywhere, incl. Primus/outputs/
outputs/
# ...but NOT a research capsule's outputs. Those are the pinned evidence the
# capsule manifest hashes; without them `capsule verify` refuses on a fresh
# clone and the replay claim is false.
!studies/capsules/**/outputs/

# --- graphify knowledge-graph cache (regenerated; never a source of truth) ---
graphify-out/

# OEIS working cache: bulk dumps + per-entry JSON + b-files + run ledger.
# Regenerated by studies/oeis_offline_prefilter.py; never a source of truth.
studies/.oeis_cache/
App/.swiftpm/
build/
