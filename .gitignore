# ============================================================
# Jacob's Portfolio Vault — one section per concern, no dupes.
# ============================================================

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- compiled native extensions ---
*.so
*.dylib
*.dll
*.rlib
target/

# --- build / packaging ---
build/
dist/
*.egg-info/
.eggs/
*.spec

# --- environments ---
.venv/
venv/
env/

# --- secrets: NEVER commit; providers read keys from the environment only ---
.env
.env.*
*.env
**/.env
**/*.env
*_api_key*
*_secret*
.chiron_llm*
llm_keys*
secrets.json
chiron.key
*.sealed
**/transcribe_hf_token
transcribe_hf_token

# --- editor / OS noise ---
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp

# --- vault runtime state (regenerated by running the scripts) ---
president_ledger.jsonl
*_pres*.jsonl
veritas_laws.jsonl
chiron_checkpoint_*.json
chiron_control.json
chiron_grow_state.json
*_grow_state.json
grow_control_state.json
**/grow_control_state.json
grow.log
nohup.out
*.dryrun

# --- artifact ledger: keep latest.json, ignore timestamped run memorials ---
Chiron/artifacts/*/[0-9]*.json

# --- monolith folder: runtime Congress copy (regenerated by build_monolith.py) ---
Chiron Monolith/chiron_memory.json

# --- local staging for files awaiting manual deletion (some sandboxes cannot unlink) ---
.trash/

# --- deliberately untracked local material ---
Creative Works/
Semic Dev/
Chiron-Refined/
modules/
**/modules/
proposals/
Resume*.md
Resume*.pdf
Resume*.docx
*Primus Calamus*.pdf

# --- transcribe tool: local env + temp audio ---
**/.transcribe_env/
*_temp_audio.wav
